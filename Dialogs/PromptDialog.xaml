<Window x:Class="VeilDesktop.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="410" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0"
        FontFamily="Segoe UI" FontSize="12">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptLabel" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="InputBox" Padding="6,5" BorderBrush="#ABADB3"/>
        <PasswordBox x:Name="SecretBox" Padding="6,5" BorderBrush="#ABADB3" Visibility="Collapsed"/>
        <TextBlock x:Name="NoteText" FontSize="11" Foreground="#555555" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Padding="0,5" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="OkBtn" Content="OK" Width="100" Padding="0,5" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
